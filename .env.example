# Generate each secret independently: openssl rand -hex 32
BRIDGE_TOKEN=change-me
DB_PASSWORD=change-me
# Host port; the container listens on 3000.
PORT=3000
# Keep localhost until HTTPS is configured. Use 0.0.0.0 only with intentional network access controls.
BIND_ADDRESS=127.0.0.1
DB_NAME=rimberio
DB_USER=rimberio_app
MAX_SESSIONS=1
AUTH_SIGNUP_MODE=first-user
AUTH_REQUIRE_HTTPS=true
ENABLE_API_DOCS=false
# For a single trusted HTTPS proxy in front of the application:
# TRUST_PROXY=true
# SMTP and other advanced options are configured in the operator console.

# Update notices: Rimberio checks the public Docker Hub tag list once a day and shows a notice
# in the console when a newer release exists. Nothing about this install is sent. Set to true
# on offline or firewalled servers to turn the check off.
# DISABLE_UPDATE_CHECK=false
